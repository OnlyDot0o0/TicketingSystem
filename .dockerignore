node_modules
.next
.git
.github
uploads
coverage
*.log
*.tsbuildinfo

# Local dev/test databases — never ship real data in the image; the
# container gets a fresh (or externally-provisioned) database via
# DATABASE_URL at runtime, migrated by docker-entrypoint.sh.
prisma/dev.db
prisma/dev.db-journal
prisma/test.db
prisma/test.db-journal
prisma/test.db-wal
prisma/test.db-shm

# Secrets — real values are injected as container environment variables,
# never baked into the image. .env.example is fine to keep (no real values).
.env
.env.*
!.env.example

# NOT excluding tests/ — vitest.config.ts (at the repo root, so it's always
# in the build context) imports ./tests/testDbUrl, and `next build`'s
# TypeScript check resolves that import even though nothing under tests/
# is otherwise used by the app itself. Excluding it broke the Docker build
# with "Cannot find module './tests/testDbUrl'" — confirmed by a real CI
# run before this fix. tests/ never ends up in the final runner image
# regardless (the runner stage only COPYs specific paths from builder/deps),
# so keeping it in the build context costs nothing at runtime.
