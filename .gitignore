node_modules/
.next/
# Anchored to the repo root (leading /) — a bare "uploads/" here also
# matched src/app/api/uploads/[...path]/route.ts (a real source file, since
# gitignore patterns with no leading slash match a directory of that name
# at ANY depth), which meant that file was silently never tracked by git
# from the day it was added. Found while touching this file for the
# object-storage abstraction (v9) and fixed here; the file itself is now
# added to tracking in the same commit.
/uploads/
prisma/dev.db
prisma/dev.db-journal
# Vitest's dedicated test database (see tests/testDbUrl.ts / tests/globalSetup.ts)
# — a separate sqlite file from dev.db, reset/migrated fresh on every
# `npm test` run, never meant to be committed.
prisma/test.db
prisma/test.db-journal
prisma/test.db-wal
prisma/test.db-shm
.env
*.log
*.tsbuildinfo
coverage/
