DATABASE_URL="file:./dev.db"

# NextAuth - generate a real secret in production: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_BASE_URL="http://localhost:3000"

# SMTP (optional in dev - if unset, notifications no-op and log to console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RAQABA+ Helpdesk <no-reply@raqaba.local>"

# Attachment storage (optional - leave unset for local disk under ./uploads,
# the zero-config default). Set STORAGE_DRIVER="s3" plus the S3_* vars below
# to use S3/R2/MinIO instead. See "Object storage abstraction" in README.md.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""

# Rate limiting (optional - leave unset for the in-memory, single-instance
# limiter, the zero-config default). Set REDIS_URL to share limits across
# instances. See "Redis-backed rate limiting" in README.md.
REDIS_URL=""

# Error tracking (optional - leave unset to disable entirely, no-op until
# set). NEXT_PUBLIC_SENTRY_DSN is usually the same value as SENTRY_DSN -
# separate vars because only NEXT_PUBLIC_-prefixed ones reach client code.
# SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed for source-map upload at
# build time. See "Error tracking hooks" in README.md.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
